# Copy this file to .env.local. Keep real credentials in that ONE ignored file.
# Production deployment uses an explicit runtime allowlist, never this entire file.

# Active app database: restricted alphatrace_app role, never postgres.
DATABASE_URL=postgresql://alphatrace_app:local-development-only@127.0.0.1:55432/alphatrace
DATABASE_SSL=false
DATABASE_SSL_CA_FILE=
# For cloud deployments, paste the trusted PEM certificate inside single quotes.
DATABASE_SSL_CA_PEM=
ALPHATRACE_LOCAL_DEV=true
ALPHATRACE_DEV_USER_ID=11111111-1111-4111-8111-111111111111
ALPHATRACE_DEV_TOKEN=replace-with-a-random-token-at-least-32-characters

# Hosted auth. These keys are server settings; do not add NEXT_PUBLIC_ prefixes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret: private document storage and verified account lookup for opted-in email delivery.
SUPABASE_SECRET_KEY=
ALPHATRACE_INVITED_USER_IDS=
ALPHATRACE_INGEST_USER_ID=
ALPHATRACE_INGEST_TOKEN=

# Provider credentials. Only IndianAPI is used by scheduled monitoring.
INDIANAPI_API_KEY=
FINCRUX_API_KEY=
UPSTOX_ANALYTICS_TOKEN=

# Production key for the website; development key for npm run trigger:dev/check.
TRIGGER_SECRET_KEY=
TRIGGER_DEV_SECRET_KEY=
ALPHATRACE_CLOUD_MONITORING=false
# Enable only after migration 014, private storage and cloud task deployment.
ALPHATRACE_DOCUMENT_JOBS=false

# Personal emails: disabled until the sender and signed webhook are configured.
ALPHATRACE_EMAILS_ENABLED=false
ALPHATRACE_APP_URL=https://alpha-trace-beryl.vercel.app
RESEND_API_KEY=
# Plain address on your verified sending domain, e.g. research@updates.example.com.
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Local administrative setup ONLY. Never upload these to Vercel or Trigger.dev.
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
MIGRATION_DATABASE_URL=postgresql://postgres:local-admin-only@127.0.0.1:55432/alphatrace

# npm run test:* and db:migrate:local select ONLY these isolated settings.
TEST_DATABASE_URL=postgresql://alphatrace_app:local-development-only@127.0.0.1:55432/alphatrace
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:local-admin-only@127.0.0.1:55432/alphatrace
TEST_DATABASE_SSL=false
TEST_ALPHATRACE_LOCAL_DEV=true
TEST_ALPHATRACE_DEV_USER_ID=11111111-1111-4111-8111-111111111111
TEST_ALPHATRACE_DEV_TOKEN=replace-with-a-random-token-at-least-32-characters
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy Python app only; excluded from cloud deployment allowlists.
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OPENAI_API_KEY=
