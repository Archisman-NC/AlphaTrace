{
  "name": "alphatrace-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "trigger:dev": "node scripts/trigger-dev.mjs",
    "trigger:check": "node --env-file=.env.local --import tsx scripts/trigger-check.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:db": "node scripts/test-local.mjs tests/database.integration.ts",
    "test:portfolio": "node scripts/test-local.mjs tests/portfolio.integration.ts",
    "test:onboarding": "node scripts/test-local.mjs tests/onboarding.integration.ts",
    "test:thesis": "node scripts/test-local.mjs tests/thesis.integration.ts",
    "test:research": "node scripts/test-local.mjs tests/research.integration.ts",
    "test:inbox": "node scripts/test-local.mjs tests/inbox.integration.ts",
    "monitor": "node --env-file-if-exists=.env.local --import tsx scripts/research-monitor.ts --watch",
    "monitor:once": "node --env-file-if-exists=.env.local --import tsx scripts/research-monitor.ts --once",
    "test:monitor": "node scripts/test-local.mjs tests/monitor.integration.ts",
    "dev:monitored": "node --env-file-if-exists=.env.local scripts/dev-monitored.mjs",
    "upstox:benchmark": "node --env-file-if-exists=.env.local --import tsx scripts/upstox-benchmark.ts",
    "fincrux:benchmark": "node --env-file-if-exists=.env.local --import tsx scripts/fincrux-benchmark.ts",
    "indianapi:benchmark": "node --env-file-if-exists=.env.local --import tsx scripts/indianapi-benchmark.ts",
    "indianapi:seed": "node --env-file-if-exists=.env.local --import tsx scripts/indianapi-worker.ts --seed-cache",
    "indianapi:worker": "node --env-file-if-exists=.env.local --import tsx scripts/indianapi-worker.ts --watch",
    "indianapi:once": "node --env-file-if-exists=.env.local --import tsx scripts/indianapi-worker.ts --once",
    "test:imports": "node scripts/test-local.mjs tests/provider-imports.integration.ts",
    "test:research-edit": "node scripts/test-local.mjs tests/research-edit.integration.ts",
    "trigger:deploy": "npx trigger.dev@4.8.3 deploy --env prod",
    "test:import-reviews": "node scripts/test-local.mjs tests/provider-reviews.integration.ts",
    "imports:backfill-reviews": "node --env-file=.env.local --import tsx scripts/backfill-provider-reviews.ts",
    "test:import-handoff": "node scripts/test-local.mjs tests/provider-handoff.integration.ts",
    "db:migrate:local": "node scripts/test-local.mjs scripts/migrate.mjs",
    "test:documents": "node scripts/test-local.mjs tests/document-jobs.integration.ts",
    "vercel:check": "node --env-file-if-exists=.env.local --import tsx scripts/vercel-check.ts",
    "storage:setup": "node --env-file=.env.local --import tsx scripts/setup-document-storage.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@trigger.dev/sdk": "^4.8.3",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.8.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "node": "22.23.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
